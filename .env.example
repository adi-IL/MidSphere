# MidSphere environment template — copy to .env and fill in.
# Never commit real tokens.

# --- DataHub GMS ---
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# --- MCP server (spawned by backend or external) ---
TOOLS_IS_MUTATION_ENABLED=true
SAVE_DOCUMENT_TOOL_ENABLED=true
# TOOLS_IS_USER_ENABLED=false

# --- MidSphere backend ---
MIDS_PHERE_HOST=0.0.0.0
MIDS_PHERE_PORT=8000
# cloud | oss
DATAHUB_TIER=oss
# full | dry_run | audit_only
DEFAULT_JOB_MODE=full
AUTO_TRIP=true
REQUIRE_MUTATIONS=1
CORS_ORIGINS=http://localhost:5173

# --- GitHub (optional; dry-run diffs if missing) ---
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# --- Gemini / Vertex (ADC preferred; no keys in repo) ---
# Use: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
# FAST_MODEL=gemini-3.6-flash
# HEAVY_MODEL=gemini-3.1-pro-preview
