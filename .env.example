# MidSphere environment template. Copy to .env. Never commit secrets.

# DataHub GMS
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# Official MCP server (uvx mcp-server-datahub)
USE_OFFICIAL_MCP=true
TOOLS_IS_MUTATION_ENABLED=false
# MCP_SERVER_CMD=uvx mcp-server-datahub@latest

# Antigravity / Gemini (Vertex ADC)
ANTIGRAVITY_ENABLED=true
ANTIGRAVITY_MODELS=gemini-3.6-flash,gemini-3.1-pro-preview
GOOGLE_CLOUD_PROJECT=project-dace7531-ac79-4f81-bd2
VERTEX_LOCATION=global

# API
CORS_ORIGINS=http://localhost:5173,https://midsphere.vercel.app
DATAHUB_TIER=oss
DEFAULT_JOB_MODE=full
AUTO_TRIP=true

# Frontend production build
# VITE_API_BASE_URL=https://midsphere-api-1053689941073.us-central1.run.app
